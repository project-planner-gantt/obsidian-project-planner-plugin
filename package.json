{
  "name": "obsidian-project-gantt-plugin",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke-host.mjs",
