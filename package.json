    "package": "npm run build && powershell.exe -NoProfile -File scripts/package.ps1"
  },
  "dependencies": {
    "@project-planner/core": "file:../project-planner-core",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.0.0",
    "obsidian": "1.14.4",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "author": "bvn13",
